# Browser-visible. The anon/publishable key is safe to expose: Row Level
# Security decides what it can reach. Baked into public/config.js at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server only. Bypasses RLS — never expose to the browser, never commit.
# Used by the crawl route and the shared rate limiter.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
