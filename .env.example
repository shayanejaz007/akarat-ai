# Browser-visible. The anon/publishable key is safe to expose: Row Level
# Security decides what it can reach. Baked into public/config.js at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server only. Bypasses RLS — never expose to the browser, never commit.
# Used by the crawl route and the shared rate limiter.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Server only. The AI advisor on the search page (/api/ai/advisor), and
# listing translation between English and Arabic (/api/translate,
# /api/admin/backfill-translations). Unset, the advisor says it is unavailable
# and the page falls back to its plain search; the listing forms leave the
# other language for the owner to fill.
ANTHROPIC_API_KEY=

# Optional, the AI advisor's limits and model. Defaults shown. The daily total
# is the ceiling on what a day can cost: see DEPLOY.md, "The AI advisor".
# AI_ADVISOR_DAILY_TOTAL=600
# AI_ADVISOR_DAILY_PER_IP=30
# AI_ADVISOR_DAILY_PER_USER=80
# AI_ADVISOR_PER_MINUTE_IP=5
# AI_ADVISOR_PER_MINUTE_USER=8
# Which model answers, and how much it thinks: property searches at low
# effort, investment questions (picked by a fixed test, not a model) at high.
# AI_ADVISOR_MODEL=claude-sonnet-5-5
# AI_ADVISOR_EFFORT=low
# AI_ADVISOR_EFFORT_INVESTMENT=high
# Estimated US dollars one answer may spend before research stops (0.02-5).
# AI_ADVISOR_MAX_TURN_USD=0.3
# The small model that suggests follow-up questions, for both assistants.
# AI_FOLLOWUP_MODEL=claude-haiku-5-5

# Server only. Ask a Lawyer (see LEGAL-AI.md). LEGAL_DATA_KEY is required for
# it to run: 32 random bytes, base64 (openssl rand -base64 32). It encrypts
# every legal conversation and document; keep a copy outside Vercel.
LEGAL_DATA_KEY=
# Until a licensed Jordanian lawyer has reviewed it, only these accounts can
# use it. Set LEGAL_ACCESS=public after the review.
LEGAL_REVIEWERS=
# LEGAL_ACCESS=reviewers
# LEGAL_DATA_KEY_PREVIOUS=
# LEGAL_AI_MODEL=claude-sonnet-5-5
# LEGAL_AI_EFFORT=medium
# Documents, court questions, urgent matters (eviction, detention, deadlines,
# inheritance) and long accounts get more thought and research:
# LEGAL_AI_EFFORT_COMPLEX=high
# Optional escalation to a stronger model for those questions. Off unless set;
# switch it on only where scripts/model-benchmark.mts shows a gain. A model
# cheaper than LEGAL_AI_MODEL, or one with no known price, is ignored.
# LEGAL_ESCALATION_MODEL=claude-opus-5-5
# LEGAL_ESCALATION_EFFORT=medium
# Any of document,court,urgent,long; empty means all of them.
# LEGAL_ESCALATE_ON=document,court
# Estimated US dollars one answer may spend before research stops (0.05-10).
# LEGAL_MAX_TURN_USD=0.8
# LEGAL_PER_MINUTE=4
# LEGAL_PER_DAY=30
# LEGAL_PER_DAY_TOTAL=300
# LEGAL_UPLOADS_PER_MINUTE=4
# Optional: embeddings and reranking for the legal library.
# VOYAGE_API_KEY=

# Server only. Any long random string; guards /api/admin/backfill-translations,
# which scripts/backfill-translations.mts calls with it.
BACKFILL_SECRET=

# Server only. The password for the admin panel at /admin. Change it in
# Vercel and redeploy to sign every admin out. Needs SUPABASE_SERVICE_ROLE_KEY.
ADMIN_PASSWORD=

# Optional. Address autocomplete and the map pin picker in the listing form.
# Leave it empty and the form keeps its city/area dropdowns — nothing breaks,
# Google is simply never loaded.
#
# This key IS browser-visible, and that is only acceptable because you restrict
# it: HTTP referrers limited to your own domains, and APIs limited to Maps
# JavaScript + Places. Set a quota cap too. Full walkthrough in LOCATIONS.md.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
