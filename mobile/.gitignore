app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Build-time configuration with real values. Only the example is committed.
/env/*.json
!/env/example.json

# iOS build secrets
/ios/Flutter/Secrets.xcconfig

# Signing material, wherever it is saved: the repo is public.
key.properties
*.jks
*.keystore
*.p12
*.p8
*.pem
*.mobileprovision
*.apk
*.aab
*.ipa

# Describes open server-side weaknesses until migration 0013 is applied;
