<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12: the brand mark on the same dark ground
     as the app's first frame (the opening), so there is no flash between them,
     whatever the theme. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ground" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash_mark" />
    </item>
</layer-list>
