<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or carried to a new device. The session lives in the
     keystore and cannot be restored elsewhere; restoring preferences without
     it would only leave stale local state behind. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
